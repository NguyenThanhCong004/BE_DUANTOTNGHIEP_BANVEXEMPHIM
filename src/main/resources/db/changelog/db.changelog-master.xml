<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Baseline: snapshot của schema đang chạy tại thời điểm 2026-07-17, sau khi đã
         sửa các vấn đề: dedupe user trùng, thêm lại 2 unique constraint (username/email),
         thêm index cho toàn bộ cột FK, thêm unique filtered index chống đặt trùng ghế.
         Đã được đánh dấu "đã áp dụng" bằng changelog-sync, không chạy lại trên DB hiện tại. -->
    <include file="db.changelog-baseline.xml" relativeToChangelogFile="true"/>

    <!-- Sửa lại filtered unique index chống đặt trùng ghế (WHERE bị mất khi generate baseline) -->
    <include file="changes/2026-07-17-fix-tickets-active-seat-index.xml" relativeToChangelogFile="true"/>

    <!-- Phim chọn nhiều thể loại: movie.genre_id (1-1) -> bảng nối movie_genres (n-n) -->
    <include file="changes/2026-07-17-movie-multi-genre.xml" relativeToChangelogFile="true"/>

    <!-- Cho phép nhân viên (staff) tự quên/đặt lại mật khẩu qua OTP email -->
    <include file="changes/2026-07-17-staff-password-reset.xml" relativeToChangelogFile="true"/>

    <!-- Bỏ đăng nhập bằng username (khách + staff chỉ còn email/SĐT); đổi tên bảng users -> customers -->
    <include file="changes/2026-07-27-drop-username-rename-customers.xml" relativeToChangelogFile="true"/>

    <!-- Nhật ký hệ thống (audit_logs) và thông báo nội bộ (notifications) cho Dashboard -->
    <include file="changes/2026-07-28-add-audit-log-notifications.xml" relativeToChangelogFile="true"/>

    <!-- Sửa kiểu cột varchar -> nvarchar trên audit_logs (lỗi đọc cột do driver dùng Unicode) -->
    <include file="changes/2026-07-28-fix-audit-logs-nvarchar.xml" relativeToChangelogFile="true"/>

    <!-- Seed cố định 3 loại ghế + 4 hạng thành viên mặc định (danh sách khóa cứng, xem SeatController/MembershipRankController) -->
    <include file="changes/2026-07-28-seed-fixed-seat-types-and-ranks.xml" relativeToChangelogFile="true"/>

    <!-- Voucher gắn với đúng 1 rạp (cinema_id NOT NULL) — Admin tạo voucher cho rạp mình,
         khách hàng chỉ dùng được voucher đúng rạp đang đặt vé -->
    <include file="changes/2026-07-28-add-voucher-cinema-scope.xml" relativeToChangelogFile="true"/>

    <!-- Các thay đổi schema MỚI kể từ đây: thêm changelog file riêng cho từng đợt thay đổi
         (vd: db/changelog/changes/2026-08-01-add-xyz.xml) rồi include vào đây, KHÔNG sửa
         trực tiếp lên DB hay dựa vào ddl-auto nữa. -->

    <!-- Soát vé QR: thêm tickets.checked_in / checked_in_at để nhân viên xác nhận khách đã vào rạp -->
    <include file="changes/2026-08-06-add-ticket-checkin.xml" relativeToChangelogFile="true"/>

    <!-- Fix unique index orders_online.receipt_token: doi sang filtered index (WHERE NOT NULL)
         vi don online moi luon co receipt_token = NULL, gay loi "duplicate key (<NULL>)"
         tu don thu 2 tro di khi khach bam Thanh toan PayOS. -->
    <include file="changes/2026-08-13-fix-receipt-token-unique-index.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
