<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Dong phong tam thoi (hong ghe/su co ky thuat): rooms.status tai dung gia tri 2 =
         "Dong tam thoi", khong can cot rieng. Them ly do + moc thoi gian dong de hien thi
         cho admin va dua vao noi dung email xin loi khach hang. -->
    <changeSet id="2026-08-18-add-room-closure-1" author="claude">
        <addColumn tableName="rooms">
            <column name="close_reason" type="nvarchar(500)"/>
        </addColumn>
    </changeSet>

    <changeSet id="2026-08-18-add-room-closure-2" author="claude">
        <addColumn tableName="rooms">
            <column name="closed_at" type="datetime2"/>
        </addColumn>
    </changeSet>

    <!-- Moc thoi gian 1 don hang duoc xu ly (doi suat hoac huy) do phong chieu bi dong,
         cung quy uoc voi orders_online.ticket_email_sent_at da co san. -->
    <changeSet id="2026-08-18-add-room-closure-3" author="claude">
        <addColumn tableName="orders_online">
            <column name="rescheduled_at" type="datetime2"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
